# Copy this file to .env and fill in real values. Never commit the real .env file.

# Backend server URL
# In production (after npm run build), the server serves the frontend too,
# so the API is on the same origin — leave this empty or set to your laptop's LAN IP.
# Example for LAN access: VITE_API_URL=http://192.168.1.100:4000
# If you're using a Cloudflare Tunnel, drivers get the URL automatically via the join QR code —
# you don't need to set this for the mobile app build.
VITE_API_URL=

# Gmail SMTP (for emailing bills / payment reminders to customers)
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an "App Password": https://myaccount.google.com/apppasswords
# 3. Paste the sending Gmail address and the 16-character app password below (no spaces needed).
GMAIL_USER=
GMAIL_APP_PASSWORD=
